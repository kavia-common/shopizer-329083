{"is_source_file": true, "format": "JavaScript", "description": "This file defines a module for drawing graphical elements in a web application using the Isomorphic SmartClient framework. It includes class definitions for drawing panes, items, lines, rectangles, ovals, and gradients, supporting multiple rendering technologies like Canvas, SVG, and VML. The code manages graphical object creation, rendering, manipulation, and maintains internal data structures such as quad-trees for spatial organization.", "external_files": ["isc", "isc.QuadTree", "isc.QuadTreeNode", "isc.DrawRect", "isc.DrawLine", "isc.DrawOval", "isc.DrawItem", "isc.Log", "isc.Element", "isc.Page", "isc.Browser", "isc.Canvas", "isc.HTMLFlow"], "external_methods": ["isc.timestamp", "isc.create", "isc.logWarn", "isc.Log.logDebug", "isc.Element.get", "isc.Page.getHelperDir", "isc.Page.getScrollWidth", "isc.Page.getScrollHeight", "isc.isA", "isc.GraphMath.trimLineEnds", "isc.addProperties", "isc.supportsOnError", "isc.isAn", "isc.svgLoaded", "isc.createAutoChild"], "published": ["isc.module_Drawing", "isc.D", "isc._moduleStart", "isc._Drawing_start", "isc._moduleEnd"], "classes": [{"name": "DrawPane", "description": "A class representing a drawing surface with support for different rendering types (Canvas, SVG, VML). It manages drawing items, quad-trees for spatial indexing, and methods for customizing the drawing state such as zoom and rotation."}, {"name": "DrawItem", "description": "A base class for drawable graphical elements such as lines, rectangles, and ovals, providing common properties and methods for rendering, interaction, and transformations."}, {"name": "DrawGroup", "description": "A subclass of DrawItem that groups multiple DrawItems, allowing collective transformations and management of child items."}, {"name": "DrawLine", "description": "A subclass of DrawItem representing a line with properties for start and end points, arrow markers, and methods to manipulate line geometry and appearance."}, {"name": "DrawRect", "description": "A subclass of DrawItem representing a rectangle with optional corner rounding, including methods for resizing and moving."}, {"name": "DrawOval", "description": "A subclass of DrawItem representing an ellipse or circle, with radius and center point management."}, {"name": "DrawOval", "description": "Represents an elliptical or circular drawable item with methods for attribute retrieval, movement, resizing, center calculation, and rendering for VML and SVG."}, {"name": "DrawSector", "description": "Defines a wedge-shaped graphical item with center point, start and end angles, radius, and methods for attribute generation and manipulation."}, {"name": "DrawLabel", "description": "A drawable text item supporting font styling, positioning, rotation, and HTML/SVG rendering, with support for interaction and text measurement."}, {"name": "DrawImage", "description": "Represents an image object with source URL, size, position, rotation, and rendering methods for multiple graphics contexts including bitmap, SVG, and VML."}, {"name": "DrawCurve", "description": "Represents a bezier curve with controls for setting start and end points, control points, bounding box calculation, and drawing in various contexts."}, {"name": "DrawBlockConnector", "description": "Specialized subclass of DrawCurve for block-like connection lines with control points."}, {"name": "DrawPath", "description": "A polyline or path shape defined by a list of points with methods for manipulating points, calculating center, and rendering."}, {"name": "DrawTriangle", "description": "A shape with predefined points forming a triangle, supporting point extraction, path attributes, and rendering."}, {"name": "DrawLinePath", "description": "A line or polyline with adjustable start and end points, featuring optional arrowheads, knobs for control points, and movement capabilities."}, {"name": "DrawKnob", "description": "Interactive control point used for manipulating drawable shapes, with properties for size, appearance, drag behavior, and updating logic."}], "methods": [{"name": "createQuadTree", "description": "Initializes the quad-tree structure for spatial partitioning within the DrawPane."}, {"name": "updateQuadTree", "description": "Updates the quad-tree with a specific item, typically after it has moved or changed."}, {"name": "addDrawItem", "description": "Adds a drawable item to the DrawPane's list of items and inserts it into the spatial index."}, {"name": "redrawBitmapNow", "description": "Immediately redraws all bitmap-based drawings, clearing the canvas and rendering each item."}, {"name": "normalize", "description": "Calculates the transformed coordinates based on current zoom and rotation settings."}, {"name": "createQuadTree", "description": "Initializes the quad-tree structure for spatial indexing within a drawing pane."}, {"name": "updateQuadTree", "description": "Updates the spatial index with a moved or changed item."}, {"name": "addDrawItem", "description": "Adds a drawable item to the drawing pane and inserts it into the spatial index."}, {"name": "redrawBitmapNow", "description": "Immediately clears and redraws all bitmap-based drawings on the canvas."}, {"name": "normalize", "description": "Computes the transformed coordinates considering zoom and rotation."}, {"name": "AnonymousFunction089660bd0100(screenRect)", "scope": "", "scopeKind": "", "description": "unavailable"}, {"name": "AnonymousFunction089660bd0200()", "scope": "isc_DrawPane__setViewBox", "scopeKind": "function", "description": "unavailable"}, {"name": "AnonymousFunction089660bd0300()", "scope": "isc_DrawPane_rotate", "scopeKind": "function", "description": "unavailable"}, {"name": "AnonymousFunction089660bd0400()", "scope": "isc_DrawPane_shouldDeferDrawing", "scopeKind": "function", "description": "unavailable"}, {"name": "AnonymousFunction089660bd0500()", "scope": "", "scopeKind": "", "description": "unavailable"}, {"name": "AnonymousFunction08966